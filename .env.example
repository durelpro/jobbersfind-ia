# =================================================================
# JITSE - JobbersFind Intelligent Trust & Skill Engine
# Configuration d'Environnement
# =================================================================

# 1. Sécurité (API Interne)
# Clé utilisée par le Backend NodeJS de JobbersFind pour parler à cette API Python
JITSE_INTERNAL_API_KEY=dev-secret-key-1234

# 2. Configuration des Agents LLM (Volume 4)
# Clés API pour les modèles qui propulsent The VisionAgent, VideoAgent, etc.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Paramètres Serveur FastAPI
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development  # 'development', 'staging', 'production'

# 4. (Futur) Connexion Base de Données & Logs
# DATABASE_URL=postgresql://user:pass@localhost:5432/jitse_db
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/jitse_logs
